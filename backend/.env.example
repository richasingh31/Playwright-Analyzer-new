PORT=4000
FRONTEND_URL=http://localhost:5173

# Windows Authentication (Trusted Connection) — the Node process runs under
# your Windows account, which needs access to the database below. No
# DB_USER/DB_PASSWORD needed.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PlaywrightAnalyzer

# Must exactly match an ODBC driver name actually installed on this machine.
# Check with (PowerShell): Get-OdbcDriver | Where-Object { $_.Name -like "*SQL Server*" }
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
